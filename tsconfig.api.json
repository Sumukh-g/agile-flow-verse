{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-api",
    "rootDir": "src",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": [
    "src/api/**/*.ts",
    "src/api/**/*.d.ts",
    "src/api/storage/multer.d.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-api",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e.ts",
    "src/api/admin",
    "src/api/**/*.spec.ts",
    "src/api/**/*.test.ts",
    "src/api/**/*.e2e.ts",
    "src/api/tasks/tasks.service.spec.ts",
    "src/api/notifications/notifications.service.spec.ts"
  ],
  "ts-node": {
    "esm": false,
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
