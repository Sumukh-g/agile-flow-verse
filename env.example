# Database (REQUIRED)
DATABASE_URL="postgresql://agileflow:agileflow_password@localhost:5432/agileflow_db"

# Redis (single connection URL — used by the API for cache, queues, notifications)
REDIS_URL=redis://localhost:6379

# Kafka (optional — only used when ENABLE_KAFKA=true)
KAFKA_BROKERS=localhost:9092

# JWT (REQUIRED — use strong random strings; must NOT contain "change-in-production" in prod)
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# API
API_URL=http://localhost:3000
PORT=3000

# CORS — comma-separated list of allowed origins.
# REQUIRED in production and must NOT be "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3000

# AI (optional — AI features are disabled and return a clear error until AI_API_KEY is set)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Provider-specific keys (optional overrides)
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Keycloak (Optional - if using Keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agile-flow
KEYCLOAK_CLIENT_ID=agile-flow-client

# Email (Optional — set ENABLE_EMAIL=true AND configure SMTP_* to actually send)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Envelope "from" address (defaults to SMTP_USER when unset)
SMTP_FROM=no-reply@your-domain.com

# Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Environment
NODE_ENV=development

# Feature Flags
ENABLE_KAFKA=false
ENABLE_EMAIL=false
ENABLE_KEYCLOAK=false

# OAuth Providers (Optional - for social login)
# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# GitHub OAuth
VITE_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Apple OAuth
VITE_APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret