# ========= DATABASE =========
# Used by Prisma + Nest when running locally (Node on your machine)
DATABASE_URL="postgresql://agileflow:agileflow_password@localhost:5432/agileflow_db"

# ========= REDIS =========
# Code uses REDIS_URL only, and falls back to in-memory cache if unset
# Leave this empty in dev unless you really want real Redis.
REDIS_URL=

# ========= KAFKA =========
# Code uses KAFKA_BROKERS; if empty, it uses a mock logger and does NOT connect.
KAFKA_BROKERS=

# ========= AUTH / JWT =========
JWT_SECRET=5774fbfc1ffb475dbd38d75ab7c0a7800f167ad6b61a570d1c113955d0730e82
JWT_REFRESH_SECRET=a19f88d009dca7aebf56184feead6d0391a3a4582da57155a3576c21495e6499
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ========= SERVER =========
API_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ========= FRONTEND =========
VITE_API_URL=http://localhost:3000

# ========= UPLOADS =========
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ========= FEATURE FLAGS (all optional, code barely uses them) =========
ENABLE_KAFKA=false
ENABLE_EMAIL=false
ENABLE_KEYCLOAK=false
