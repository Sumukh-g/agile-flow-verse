// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sku       String   @default("basic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  projects         Project[]
  features         TenantFeature[]
  auditLogs        AuditLog[]
  outbox           Outbox[]
  notes            Note[]
  comments         Comment[]
  roles            RoleAssignment[]
  projectMember    ProjectMember[]
  agents           Agent[]
  agentRuns        AgentRun[]
  // Added missing opposites
  tasks            Task[]
  taskAssignees    TaskAssignee[]
  taskDependencies TaskDependency[]
  attachments      Attachment[]
  timesheets       Timesheet[]
  calendarEvents   CalendarEvent[]
  calendars        Calendar[]
  events           Event[]

  @@map("tenants")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String   @default("basic")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantFeatures TenantFeature[]

  @@map("feature_flags")
}

model TenantFeature {
  id         String   @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  projects        Project[]
  timesheets      Timesheet[]
  auditLogs       AuditLog[]
  taskAssignees   TaskAssignee[]
  projectMembers  ProjectMember[]
  comments        Comment[]
  calendarEvents  CalendarEvent[]
  
  // Calendar relations
  ownedCalendars Calendar[] @relation("CalendarOwner")
  createdEvents  Event[]    @relation("EventCreator")
  updatedEvents  Event[]    @relation("EventUpdater")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@map("role_assignments")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  priority    String   @default("medium")
  progress    Int      @default(0)
  budget      Float?
  spent       Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  tenantId    String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator        User            @relation(fields: [createdBy], references: [id])
  tasks          Task[]
  notes          Note[]
  members        ProjectMember[]
  calendarEvents CalendarEvent[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, userId])
  @@map("project_members")
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("todo")
  priority       String   @default("medium")
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float    @default(0)
  projectId      String
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timesheets       Timesheet[]
  assignees        TaskAssignee[]
  dependenciesFrom TaskDependency[] @relation("fromTask")
  dependenciesTo   TaskDependency[] @relation("toTask")

  @@map("tasks")
}

model TaskAssignee {
  id       String @id @default(cuid())
  tenantId String
  taskId   String
  userId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taskId, userId])
  @@map("task_assignees")
}

model TaskDependency {
  id         String @id @default(cuid())
  tenantId   String
  fromTaskId String
  toTaskId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from   Task   @relation("fromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  to     Task   @relation("toTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromTaskId, toTaskId])
  @@map("task_dependencies")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   // JSON string
  parentId  String?
  projectId String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Vector embedding for enterprise search (1536 dims) via raw migration
  embedding Unsupported("vector")?

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Note?   @relation("NoteChildren", fields: [parentId], references: [id])
  children Note[]  @relation("NoteChildren")
  comments Comment[]
  attachments Attachment[]

  @@map("notes")
}

model Attachment {
  id        String   @id @default(cuid())
  tenantId  String
  noteId    String
  filename  String
  mimeType  String
  sizeBytes Int
  path      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Comment {
  id        String   @id @default(cuid())
  tenantId  String
  noteId    String
  content   String
  createdBy String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [createdBy], references: [id])

  @@map("comments")
}

model Timesheet {
  id        String   @id @default(cuid())
  date      DateTime
  hours     Float
  description String?
  taskId    String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("timesheets")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  tenantId  String?
  details   Json?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("audit_logs")
}

model Outbox {
  id        String   @id @default(cuid())
  aggregate String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("outbox")
}

model Agent {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  role      String   // Intake | Planner | Comms | Summarizer
  tools     String[] // allowlist
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AgentRun[]

  @@map("agents")
}

model AgentRun {
  id        String   @id @default(cuid())
  tenantId  String
  agentId   String
  toolCalls Int      @default(0)
  input     Json
  output    Json?
  costCents Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_runs")
}

model Calendar {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  color       String   @default("#3b82f6")
  isDefault   Boolean  @default(false)
  isShared    Boolean  @default(false)
  ownerUserId String?
  sectionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner   User?    @relation("CalendarOwner", fields: [ownerUserId], references: [id])
  events  Event[]

  @@map("calendars")
}

model Event {
  id          String   @id @default(cuid())
  tenantId    String
  calendarId  String
  title       String
  description String?
  location    String?
  allDay      Boolean  @default(false)
  startAt     DateTime
  endAt       DateTime
  rrule       String?  // RRULE string for recurring events
  exDates     String?  // JSON array of exception dates
  timeZone    String   @default("UTC")
  reminders   Json?    // JSON array of reminder settings
  attendees   Json?    // JSON array of attendee objects
  visibility  EventVisibility @default(default)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  creator  User     @relation("EventCreator", fields: [createdBy], references: [id])
  updater  User?    @relation("EventUpdater", fields: [updatedBy], references: [id])
  invites  EventInvite[]

  @@index([tenantId, calendarId, startAt, endAt])
  @@index([deletedAt])
  @@map("events")
}

model EventInvite {
  id       String        @id @default(cuid())
  eventId  String
  email    String
  status   InviteStatus  @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_invites")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  type        String   // 'meeting' | 'task' | 'reminder' | 'event' | 'deadline' | 'appointment'
  priority    String?  // 'low' | 'medium' | 'high' | 'urgent'
  location    String?
  attendees   String[]
  isOnline    Boolean  @default(false)
  isRecurring Boolean  @default(false)
  recurrence  String?  // 'daily' | 'weekly' | 'monthly' | 'yearly'
  reminder    Int?     // minutes before
  color       String?
  completed   Boolean  @default(false)
  notes       String?
  projectId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [createdBy], references: [id])

  @@map("calendar_events")
}

enum EventVisibility {
  default
  private
  public
}

enum InviteStatus {
  pending
  accepted
  declined
} 