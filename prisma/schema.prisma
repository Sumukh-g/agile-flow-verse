// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sku       String   @default("basic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  projects         Project[]
  features         TenantFeature[]
  auditLogs        AuditLog[]
  outbox           Outbox[]
  notes            Note[]
  comments         Comment[]
  roles            RoleAssignment[]
  projectMember    ProjectMember[]
  agents           Agent[]
  agentRuns        AgentRun[]
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  // Added missing opposites
  tasks            Task[]
  taskAssignees    TaskAssignee[]
  taskDependencies TaskDependency[]
  attachments      Attachment[]
  timesheets       Timesheet[]
  workflows        Workflow[]
  workflowExecutions WorkflowExecution[]
  // CRM back-relations
  crmClients       CrmClient[]      @relation("TenantToCrmClients")
  crmProjects      CrmProject[]     @relation("TenantToCrmProjects")
  crmDeals         CrmDeal[]        @relation("TenantToCrmDeals")
  // Forms
  forms            Form[]
  formResponses    FormResponse[]
  formShares       FormShare[]
  // Issues
  issues           Issue[]

  @@map("tenants")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String   @default("basic")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantFeatures TenantFeature[]

  @@map("feature_flags")
}

model TenantFeature {
  id         String   @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?  // Optional for existing users, required for new signups
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  projects        Project[]
  timesheets      Timesheet[]
  auditLogs       AuditLog[]
  taskAssignees   TaskAssignee[]
  projectMembers  ProjectMember[]
  comments        Comment[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  // CRM back-relations
  crmClients      CrmClient[]      @relation("UserToCrmClients")
  crmProjects     CrmProject[]     @relation("UserToCrmProjects")
  crmDeals        CrmDeal[]        @relation("UserToCrmDeals")
  // Forms
  createdForms    Form[]
  formResponses   FormResponse[]
  formShares      FormShare[]
  // Issues
  reportedIssues  Issue[]  @relation("IssueReporter")
  assignedIssues  Issue[]  @relation("IssueAssignee")
  // Attachments
  uploadedAttachments Attachment[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@map("role_assignments")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  priority    String   @default("medium")
  progress    Int      @default(0)
  budget      Float?
  spent       Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  tenantId    String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User         @relation(fields: [createdBy], references: [id])
  tasks       Task[]
  notes       Note[]
  members     ProjectMember[]
  workflows   Workflow[]
  forms       Form[]
  attachments Attachment[]
  issues      Issue[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, userId])
  @@map("project_members")
}

// ---------- CRM MODELS ----------
model CrmClient {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  company     String?
  email       String?
  phone       String?
  status      String   @default("lead") // lead | prospect | client | inactive
  value       Float    @default(0)
  lastContact DateTime? 
  industry    String?
  source      String?
  assignedTo  String?
  tags        String[] @default([])
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant @relation("TenantToCrmClients", fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User   @relation("UserToCrmClients", fields: [createdBy], references: [id])
  projects CrmProject[]
  deals    CrmDeal[]

  @@index([tenantId])
  @@map("crm_clients")
}

model CrmProject {
  id           String   @id @default(cuid())
  tenantId     String
  clientId     String?
  name         String
  description  String?
  status       String   @default("in-progress")
  priority     String   @default("medium")
  progress     Int      @default(0)
  budget       Float    @default(0)
  spent        Float    @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant     @relation("TenantToCrmProjects", fields: [tenantId], references: [id], onDelete: Cascade)
  client  CrmClient? @relation(fields: [clientId], references: [id])
  creator User       @relation("UserToCrmProjects", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("crm_projects")
}

model CrmDeal {
  id                String   @id @default(cuid())
  tenantId          String
  title             String
  clientId          String
  value             Float    @default(0)
  stage             String   @default("lead") // lead | qualified | proposal | negotiation | closed-won | closed-lost
  probability       Int      @default(0)
  expectedCloseDate DateTime?
  source            String?
  assignedTo        String?
  lastActivity      DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant     @relation("TenantToCrmDeals", fields: [tenantId], references: [id], onDelete: Cascade)
  client CrmClient  @relation(fields: [clientId], references: [id])
  creator User      @relation("UserToCrmDeals", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("crm_deals")
}
model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("todo")
  priority       String   @default("medium")
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float    @default(0)
  projectId      String
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timesheets       Timesheet[]
  assignees        TaskAssignee[]
  dependenciesFrom TaskDependency[] @relation("fromTask")
  dependenciesTo   TaskDependency[] @relation("toTask")

  @@map("tasks")
}

model TaskAssignee {
  id       String @id @default(cuid())
  tenantId String
  taskId   String
  userId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taskId, userId])
  @@map("task_assignees")
}

model TaskDependency {
  id         String @id @default(cuid())
  tenantId   String
  fromTaskId String
  toTaskId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from   Task   @relation("fromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  to     Task   @relation("toTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromTaskId, toTaskId])
  @@map("task_dependencies")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   // JSON string
  parentId  String?
  projectId String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Vector embedding for enterprise search (1536 dims) via raw migration
  embedding Unsupported("vector")?

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Note?   @relation("NoteChildren", fields: [parentId], references: [id])
  children Note[]  @relation("NoteChildren")
  comments Comment[]
  attachments Attachment[]

  @@map("notes")
}

model Attachment {
  id        String   @id @default(cuid())
  tenantId  String
  noteId    String?
  projectId String?
  issueId   String?
  filename  String
  mimeType  String
  sizeBytes Int
  path      String
  uploadedBy String
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([issueId])
  @@map("attachments")
}

model Comment {
  id        String   @id @default(cuid())
  tenantId  String
  noteId    String?
  issueId   String?
  content   String
  createdBy String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note   Note?  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  issue  Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [createdBy], references: [id])

  @@index([issueId])
  @@map("comments")
}

model Timesheet {
  id        String   @id @default(cuid())
  date      DateTime
  hours     Float
  description String?
  taskId    String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("timesheets")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  tenantId  String?
  details   Json?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("audit_logs")
}

model Outbox {
  id        String   @id @default(cuid())
  aggregate String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  tenantId  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("outbox")
}

model Agent {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  role      String   // Intake | Planner | Comms | Summarizer
  tools     String[] // allowlist
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AgentRun[]

  @@map("agents")
}

model AgentRun {
  id        String   @id @default(cuid())
  tenantId  String
  agentId   String
  toolCalls Int      @default(0)
  input     Json
  output    Json?
  costCents Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_runs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  type        String   // task.assigned, task.updated, etc.
  title       String
  message     String
  data        Json     @default("{}")
  channels    String[] @default(["in_app"])
  priority    String   @default("medium")
  read        Boolean  @default(false)
  readAt      DateTime?
  archived    Boolean  @default(false)
  archivedAt  DateTime?
  source      String?  // Service source: Gmail, Slack, etc.
  category    String?  // Important, Social, Work
  scheduledFor DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([read, archived])
  @@map("notifications")
}

model NotificationService {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  icon      String   @default("Bell")
  color     String   @default("bg-gray-500")
  enabled   Boolean  @default(true)
  connected Boolean  @default(false)
  category  String   // Important, Social, Work
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, name])
  @@index([tenantId, userId])
  @@map("notification_services")
}

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  enabled     Boolean  @default(true)
  trigger     Json
  conditions  Json
  actions     Json
  projectId   String?
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([enabled])
  @@map("workflows")
}

model WorkflowExecution {
  id         String   @id @default(cuid())
  tenantId   String
  workflowId String
  status     String
  data       Json
  error      String?
  
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([workflowId])
  @@index([createdAt])
  @@map("workflow_executions")
}

model Form {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String?
  title       String
  description String?
  fields      Json     // Array of FormField
  status      String   @default("draft") // draft | active | closed | archived
  type        String?  // survey | feedback | bug-report | requirements | review | application
  settings    Json     @default("{}") // { allowAnonymous, requireLogin, sendConfirmation, limitResponses, maxResponses, etc }
  isPublic    Boolean  @default(false)
  views       Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User          @relation(fields: [createdBy], references: [id])
  responses FormResponse[]
  shares   FormShare[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@map("forms")
}

model FormResponse {
  id          String   @id @default(cuid())
  tenantId    String
  formId      String
  submittedBy String?  // null if anonymous
  data        Json     // Response data: { fieldId: value }
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [submittedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([formId])
  @@index([submittedBy])
  @@index([submittedAt])
  @@map("form_responses")
}

model FormShare {
  id        String   @id @default(cuid())
  tenantId  String
  formId    String
  userId    String?  // null for public share
  access    String   @default("view") // view | respond | edit
  shareLink String?  // unique share link if public
  expiresAt DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareLink])
  @@index([tenantId])
  @@index([formId])
  @@index([userId])
  @@map("form_shares")
}

model Issue {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  title       String
  description String?
  status      String   @default("backlog") // backlog | todo | in-progress | review | done | closed
  priority    String   @default("medium")  // low | medium | high | critical
  type        String   @default("task")    // bug | feature | task | improvement
  severity    String?  // minor | major | critical | blocker (for bugs)
  assigneeId String?
  reporterId String
  tags        String[] @default([])
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User    @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  comments Comment[]
  attachments Attachment[]

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@map("issues")
} 