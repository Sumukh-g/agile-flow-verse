model Issue {
  id          String         @id @default(cuid())
  tenantId    String
  projectId   String
  title       String
  description String?
  status      IssueStatus    @default(INBOX)
  priority    IssuePriority  @default(P2)
  type        IssueType      @default(TASK)
  severity    IssueSeverity?
  assigneeId  String?
  reporterId  String
  tags        String[]       @default([])
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  componentId String?
  attachments Attachment[]
  comments    Comment[]
  assignee    User?          @relation("IssueAssignee", fields: [assigneeId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User           @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Advanced issue features (Phase 8)
  linksFrom   IssueLink[]      @relation("IssueLinkSource")
  linksTo     IssueLink[]      @relation("IssueLinkTarget")
  watchers    IssueWatcher[]
  votes       IssueVote[]
  changelog   IssueChangelog[]

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([componentId])
  @@index([tenantId, projectId, status, priority])
  @@index([tenantId, status, priority])
  @@map("issues")
}

// ============================================
// Phase 8: Advanced Issue Features
// ============================================

/// Issue links (blocks, duplicates, relates to)
model IssueLink {
  id            String        @id @default(cuid())
  tenantId      String
  sourceIssueId String
  targetIssueId String
  linkType      IssueLinkType
  createdAt     DateTime      @default(now())
  createdById   String
  
  sourceIssue   Issue         @relation("IssueLinkSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue   Issue         @relation("IssueLinkTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, linkType])
  @@index([tenantId])
  @@index([sourceIssueId])
  @@index([targetIssueId])
  @@map("issue_links")
}

enum IssueLinkType {
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
  IS_DUPLICATED_BY
  RELATES_TO
}

/// Issue watchers (users following issue updates)
model IssueWatcher {
  id        String   @id @default(cuid())
  tenantId  String
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([tenantId])
  @@index([issueId])
  @@index([userId])
  @@map("issue_watchers")
}

/// Issue votes (for prioritization)
model IssueVote {
  id        String   @id @default(cuid())
  tenantId  String
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([tenantId])
  @@index([issueId])
  @@index([userId])
  @@map("issue_votes")
}

/// Issue changelog for audit trail
model IssueChangelog {
  id        String   @id @default(cuid())
  tenantId  String
  issueId   String
  userId    String
  field     String   // Field that was changed
  oldValue  String?  // Previous value (JSON stringified)
  newValue  String?  // New value (JSON stringified)
  createdAt DateTime @default(now())
  
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([issueId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("issue_changelog")
}

model CalendarEvent {
  id                    String                   @id @default(cuid())
  tenantId              String
  projectId             String?
  sectionId             String?
  title                 String
  description           String?
  startAt               DateTime
  endAt                 DateTime
  allDay                Boolean                  @default(false)
  type                  CalendarEventType        @default(OTHER)
  sourceType            CalendarEventSourceType?
  sourceId              String?
  createdById           String
  reminderMinutesBefore Int?
  externalSource        ExternalCalendarSource   @default(NONE)
  externalCalendarId    String?
  externalEventId       String?
  syncDirection         CalendarSyncDirection    @default(APP_TO_EXTERNAL)
  lastSyncedAt          DateTime?
  syncStatus            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  creator               User                     @relation("CalendarEventCreator", fields: [createdById], references: [id])
  project               Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([sectionId])
  @@index([startAt])
  @@index([endAt])
  @@index([sourceType, sourceId])
  @@index([createdById])
  @@index([externalSource, externalEventId])
  @@map("calendar_events")
}

model UserIntegration {
  id             String    @id @default(cuid())
  userId         String
  tenantId       String
  provider       String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  externalUserId String?
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User      @relation("UserIntegrations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, provider])
  @@index([tenantId, userId])
  @@index([provider])
  @@map("user_integrations")
}

enum IssueStatus {
  INBOX
  NEEDS_INFO
  TRIAGED
  PLANNED
  READY_FOR_DEV
  IN_PROGRESS
  IN_REVIEW
  IN_QA
  DONE
  WONT_DO
  DUPLICATE
  ON_HOLD
}

enum IssueType {
  BUG
  STORY
  TASK
  INCIDENT
  SUPPORT
}

enum IssueSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum IssuePriority {
  P0
  P1
  P2
  P3
}

enum NoteScope {
  PERSONAL
  PROJECT
}

enum CalendarEventType {
  MEETING
  TASK_DEADLINE
  ISSUE_DUE
  REMINDER
  NOTE_DATE
  OTHER
}

enum CalendarEventSourceType {
  TASK
  ISSUE
  NOTE
}

enum ExternalCalendarSource {
  NONE
  GOOGLE
  OUTLOOK
}

enum CalendarSyncDirection {
  APP_TO_EXTERNAL
  EXTERNAL_TO_APP
  BIDIRECTIONAL
}

// ============================================
// FINANCE BOARD MODELS
// ============================================

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  DISPUTED
}

enum InvoiceGroupingStrategy {
  DETAILED // Every time log as a row
  BY_ROLE // Group by user role
  BY_EPIC // Group by epic/feature
  BY_TASK // Group by task
  BY_USER // Group by individual user
  BY_DATE // Group by date/week/month
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REIMBURSED
  INVOICED
}

enum ExpenseCategory {
  TRAVEL
  SOFTWARE
  HARDWARE
  HOSTING
  MARKETING
  OFFICE_SUPPLIES
  CONSULTING
  SUBCONTRACTOR
  MEALS
  ACCOMMODATION
  TRANSPORTATION
  COMMUNICATION
  TRAINING
  LICENSE
  OTHER
}

enum BudgetAlertType {
  THRESHOLD_WARNING // 80% budget used
  THRESHOLD_CRITICAL // 95% budget used
  OVERSPEND // Budget exceeded
  MONTHLY_REPORT // Monthly summary
}

model Invoice {
  id               String                  @id @default(cuid())
  tenantId         String
  projectId        String
  clientId         String? // Link to CRM client
  invoiceNumber    String // Auto-generated: INV-2024-001
  status           InvoiceStatus           @default(DRAFT)
  groupingStrategy InvoiceGroupingStrategy @default(BY_ROLE)

  // Date Range
  periodStart DateTime
  periodEnd   DateTime
  issueDate   DateTime @default(now())
  dueDate     DateTime

  // Financial
  currency        String @default("USD")
  subtotal        Float  @default(0)
  taxPercent      Float  @default(0)
  taxAmount       Float  @default(0)
  discountPercent Float  @default(0)
  discountAmount  Float  @default(0)
  grandTotal      Float  @default(0)
  amountPaid      Float  @default(0)
  balanceDue      Float  @default(0)

  // Settings
  includeTimesheets     Boolean @default(true)
  includeExpenses       Boolean @default(true)
  includeFixedTasks     Boolean @default(false)
  showDetailedBreakdown Boolean @default(false)

  // JSON Data
  lineItems   Json    @default("[]") // Calculated line items
  metadata    Json    @default("{}") // Additional data
  terms       String? // Payment terms
  notes       String? // Internal notes
  clientNotes String? // Notes visible to client

  // PDF/Export
  pdfUrl         String?
  lastExportedAt DateTime?

  // Audit
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  sentAt       DateTime?
  viewedAt     DateTime?
  paidAt       DateTime?
  voidedAt     DateTime?
  voidReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client     CrmClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creator    User        @relation("InvoiceCreator", fields: [createdById], references: [id])
  approver   User?       @relation("InvoiceApprover", fields: [approvedById], references: [id])
  timesheets Timesheet[]
  expenses   Expense[]
  payments   Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("invoices")
}

model Expense {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String
  userId    String // Who submitted
  invoiceId String? // Links to invoice when billed

  // Details
  title       String
  description String?
  category    ExpenseCategory @default(OTHER)
  amount      Float
  currency    String          @default("USD")
  date        DateTime
  vendor      String? // Vendor/supplier name

  // Status & Approval
  status           ExpenseStatus @default(DRAFT)
  billable         Boolean       @default(true)
  billableToClient Boolean       @default(true)
  markup           Float         @default(0) // Markup percentage for client billing

  // Approval workflow
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  // Receipt/Attachment
  receiptUrl      String?
  receiptFilename String?

  // Tax
  taxDeductible Boolean @default(false)
  taxCategory   String?

  // Metadata
  tags     String[] @default([])
  metadata Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User     @relation("ExpenseSubmitter", fields: [userId], references: [id])
  approver User?    @relation("ExpenseApprover", fields: [approvedById], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([projectId])
  @@index([userId])
  @@index([invoiceId])
  @@index([status])
  @@index([date])
  @@index([billable])
  @@map("expenses")
}

model BillableRate {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String? // Project-specific rate (null = global)
  userId    String? // User-specific rate (null = role-based)
  role      String? // Role-based rate (e.g., "senior_developer")

  // Rate info
  hourlyRate    Float
  currency      String    @default("USD")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Metadata
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
  @@map("billable_rates")
}

model Payment {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  // Payment details
  amount          Float
  currency        String   @default("USD")
  paymentDate     DateTime
  paymentMethod   String? // bank_transfer, credit_card, paypal, check, etc.
  referenceNumber String? // Transaction ID, check number, etc.

  // Status
  status String @default("completed") // pending, completed, failed, refunded

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model Budget {
  id        String @id @default(cuid())
  tenantId  String
  projectId String

  // Budget details
  name        String
  totalAmount Float
  currency    String    @default("USD")
  startDate   DateTime
  endDate     DateTime?

  // Tracking
  allocatedAmount Float @default(0)
  spentAmount     Float @default(0)

  // Settings
  alertThreshold Float   @default(80) // Alert at 80%
  isActive       Boolean @default(true)

  // Categories (JSON for flexibility)
  categories Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alerts  BudgetAlert[]

  @@index([tenantId])
  @@index([projectId])
  @@index([isActive])
  @@map("budgets")
}

model BudgetAlert {
  id       String @id @default(cuid())
  tenantId String
  budgetId String

  alertType BudgetAlertType
  threshold Float?
  message   String

  // Status
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([budgetId])
  @@index([acknowledged])
  @@map("budget_alerts")
}

model FinancialReport {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String?

  // Report details
  reportType  String // profit_loss, cashflow, expense_summary, time_analysis, etc.
  title       String
  periodStart DateTime
  periodEnd   DateTime

  // Generated data
  data Json

  // Export
  exportUrl String?

  createdById String
  createdAt   DateTime @default(now())

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User     @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([reportType])
  @@map("financial_reports")
}

model RecurringInvoice {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String
  clientId  String?

  // Schedule
  frequency   String // weekly, biweekly, monthly, quarterly
  nextRunDate DateTime
  lastRunDate DateTime?

  // Template
  templateSettings Json // Invoice settings to use

  // Status
  isActive Boolean @default(true)
  autoSend Boolean @default(false)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creator User       @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([nextRunDate])
  @@index([isActive])
  @@map("recurring_invoices")
}

// ─── Automation Engine v2 ──────────────────────────────────────────────────────

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  DRY_RUN
}

enum AutomationStepType {
  CONDITION
  ACTION
  BRANCH
}

enum AutomationStepStatus {
  SUCCESS
  FAILED
  SKIPPED
  DRY_RUN
}

/// A configured automation rule (trigger → conditions → steps)
model AutomationRule {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String?
  name         String
  description  String?
  isActive     Boolean  @default(true)
  /// TriggerKey enum value  (e.g. "task.status.changed")
  triggerKey   String
  /// JSON: additional params scoped to the trigger
  triggerParams Json    @default("{}")
  /// JSON: optional global ConditionNode tree evaluated before steps run
  conditions   Json?
  /// JSON: ActionStep[] tree supporting ActionLeaf + BranchNode
  steps        Json
  /// Monotonically increasing version for optimistic-lock protection
  version      Int      @default(1)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User      @relation(fields: [createdById], references: [id])
  executions AutomationExecution[]

  @@index([tenantId, isActive])
  @@index([triggerKey])
  @@index([projectId])
  @@map("automation_rules")
}

/// One execution record per trigger-fire event
model AutomationExecution {
  id             String                   @id @default(cuid())
  ruleId         String
  tenantId       String
  status         AutomationExecutionStatus @default(PENDING)
  isDryRun       Boolean                  @default(false)
  /// Snapshot of the raw event payload that triggered this execution
  triggerPayload Json
  /// Computed context variables at execution time
  context        Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  /// SHA-256 of ruleId + eventFingerprint + minute-bucket — prevents duplicate execution on retry
  idempotencyKey String                   @unique
  /// Depth in an automation chain (for circuit-breaker)
  chainDepth     Int                      @default(0)
  createdAt      DateTime                 @default(now())

  rule     AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stepLogs AutomationStepLog[]

  @@index([ruleId, status])
  @@index([tenantId, createdAt])
  @@index([idempotencyKey])
  @@map("automation_executions")
}

/// Granular per-step log within an execution (conditions + actions)
model AutomationStepLog {
  id            String               @id @default(cuid())
  executionId   String
  stepIndex     Int
  stepType      AutomationStepType
  /// e.g. "field.equals", "webhook.send", "branch"
  stepKey       String
  status        AutomationStepStatus
  /// Input params/payload for this step
  inputPayload  Json
  /// Return value from the step handler
  outputPayload Json?
  errorMessage  String?
  /// Full stack trace for failed steps
  errorStack    String?
  durationMs    Int?
  createdAt     DateTime             @default(now())

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("automation_step_logs")
}
