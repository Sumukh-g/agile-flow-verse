generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  sku                String              @default("basic")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentRuns          AgentRun[]
  agents             Agent[]
  attachments        Attachment[]
  auditLogs          AuditLog[]
  calendarEvents     CalendarEvent[]
  comments           Comment[]
  crmClients         CrmClient[]         @relation("TenantToCrmClients")
  crmDeals           CrmDeal[]           @relation("TenantToCrmDeals")
  crmProjects        CrmProject[]        @relation("TenantToCrmProjects")
  formResponses      FormResponse[]
  formShares         FormShare[]
  forms              Form[]
  ganttDependencies  GanttDependency[]
  ganttTasks         GanttTask[]
  issues             Issue[]
  kanbanCards        KanbanCard[]
  kanbanColumns      KanbanColumn[]
  notes              Note[]
  notifications      Notification[]
  outbox             Outbox[]
  projectMember      ProjectMember[]
  projects           Project[]
  refreshTokens      RefreshToken[]
  roles              RoleAssignment[]
  taskAssignees      TaskAssignee[]
  taskDependencies   TaskDependency[]
  tasks              Task[]
  features           TenantFeature[]
  invitations        TenantInvitation[]
  timesheets         Timesheet[]
  userIntegrations   UserIntegration[]
  userTenants        UserTenant[]
  users              User[]
  workflowExecutions WorkflowExecution[]
  workflows          Workflow[]
  // Automation Engine v2
  automationRules    AutomationRule[]
  automationExecutions AutomationExecution[]
  // Finance relations
  invoices           Invoice[]
  expenses           Expense[]
  billableRates      BillableRate[]
  payments           Payment[]
  budgets            Budget[]
  budgetAlerts       BudgetAlert[]
  financialReports   FinancialReport[]
  recurringInvoices  RecurringInvoice[]
  TimeLog            TimeLog[]
  // Agile/Scrum relations
  sprints            Sprint[]
  epics              Epic[]
  definitionOfDone   DefinitionOfDone[]
  dodChecks          DoDCheck[]
  sprintReviews      SprintReview[]
  sprintCapacities   SprintCapacity[]
  cardEmbeddings     CardEmbedding[]

  @@map("tenants")
}

model FeatureFlag {
  id             String          @id @default(cuid())
  key            String          @unique
  name           String
  description    String?
  category       String          @default("basic")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenantFeatures TenantFeature[]

  @@map("feature_flags")
}

model TenantFeature {
  id          String      @id @default(cuid())
  tenantId    String
  featureKey  String
  enabled     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  featureFlag FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String
  tenantId              String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  password              String?
  // Two-Factor Authentication (2FA/TOTP) fields
  totpSecret            String?            // Encrypted TOTP secret
  totpEnabled           Boolean            @default(false) // Whether 2FA is enabled
  totpBackupCodes       String?            // JSON array of backup codes (encrypted)
  totpVerifiedAt        DateTime?         // When 2FA was verified during setup
  uploadedAttachments   Attachment[]
  auditLogs             AuditLog[]
  createdCalendarEvents CalendarEvent[]    @relation("CalendarEventCreator")
  comments              Comment[]
  createdNotes          Note[]              @relation("NoteCreatedBy")
  updatedNotes          Note[]              @relation("NoteUpdatedBy")
  crmClients            CrmClient[]        @relation("UserToCrmClients")
  crmDeals              CrmDeal[]          @relation("UserToCrmDeals")
  crmProjects           CrmProject[]       @relation("UserToCrmProjects")
  formResponses         FormResponse[]
  formShares            FormShare[]
  createdForms          Form[]
  assignedIssues        Issue[]            @relation("IssueAssignee")
  reportedIssues        Issue[]            @relation("IssueReporter")
  notifications         Notification[]
  projectMembers        ProjectMember[]
  projects              Project[]
  refreshTokens         RefreshToken[]
  roleAssignments       RoleAssignment[]
  taskAssignees         TaskAssignee[]
  sentTenantInvitations TenantInvitation[] @relation("TenantInvitationInvitedBy")
  timeLogs              TimeLog[]
  timesheets            Timesheet[]
  integrations          UserIntegration[]  @relation("UserIntegrations")
  invitedUserTenants    UserTenant[]       @relation("UserTenantInvitedBy")
  userTenants           UserTenant[]
  tenant                Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Finance relations
  createdInvoices       Invoice[]          @relation("InvoiceCreator")
  approvedInvoices      Invoice[]          @relation("InvoiceApprover")
  expenses              Expense[]          @relation("ExpenseSubmitter")
  approvedExpenses      Expense[]          @relation("ExpenseApprover")
  billableRates         BillableRate[]
  financialReports      FinancialReport[]
  recurringInvoices     RecurringInvoice[]
  createdAutomationRules AutomationRule[]
  sprintCapacities       SprintCapacity[]

  @@index([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  tenantId String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@map("role_assignments")
}

model Project {
  id                String             @id @default(cuid())
  name              String
  description       String?
  status            String             @default("active")
  priority          String             @default("medium")
  progress          Int                @default(0)
  budget            Float?
  spent             Float              @default(0)
  startDate         DateTime?
  endDate           DateTime?
  tenantId          String
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archived          Boolean            @default(false)
  deletedAt         DateTime?
  // Finance settings
  defaultCurrency   String             @default("USD")
  billingType       String             @default("time_materials") // time_materials, fixed_price, retainer
  defaultBillable   Boolean            @default(true)
  attachments       Attachment[]
  calendarEvents    CalendarEvent[]
  forms             Form[]
  ganttTasks        GanttTask[]
  issues            Issue[]
  kanbanCards       KanbanCard[]
  kanbanColumns     KanbanColumn[]
  notes             Note[]
  members           ProjectMember[]
  creator           User               @relation(fields: [createdBy], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks             Task[]
  workflows         Workflow[]
  // Finance relations
  timesheets        Timesheet[]
  invoices          Invoice[]
  expenses          Expense[]
  billableRates     BillableRate[]
  budgets           Budget[]
  financialReports  FinancialReport[]
  recurringInvoices RecurringInvoice[]
  // Agile/Scrum relations
  sprints           Sprint[]
  epics             Epic[]
  definitionOfDone  DefinitionOfDone?
  // Automation Engine v2
  automationRules   AutomationRule[]

  @@index([deletedAt])
  @@index([archived])
  @@index([tenantId, createdBy, deletedAt])
  @@index([tenantId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, userId])
  @@index([tenantId, userId])
  @@index([projectId])
  @@map("project_members")
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  invitedBy String?
  inviter   User?    @relation("UserTenantInvitedBy", fields: [invitedBy], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenants")
}

model TenantInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       String    @default("member")
  token      String    @unique
  invitedBy  String
  status     String    @default("pending")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  inviter    User      @relation("TenantInvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email, status])
  @@index([token])
  @@index([tenantId])
  @@index([email])
  @@map("tenant_invitations")
}

model CrmClient {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  company           String?
  email             String?
  phone             String?
  status            String             @default("lead")
  value             Float              @default(0)
  lastContact       DateTime?
  industry          String?
  source            String?
  assignedTo        String?
  tags              String[]           @default([])
  notes             String?
  // Billing info
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingZip        String?
  billingCountry    String?
  taxId             String? // VAT/Tax ID
  paymentTermsDays  Int                @default(30)
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  creator           User               @relation("UserToCrmClients", fields: [createdBy], references: [id])
  tenant            Tenant             @relation("TenantToCrmClients", fields: [tenantId], references: [id], onDelete: Cascade)
  deals             CrmDeal[]
  projects          CrmProject[]
  // Finance relations
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@index([tenantId])
  @@map("crm_clients")
}

model CrmProject {
  id          String     @id @default(cuid())
  tenantId    String
  clientId    String?
  name        String
  description String?
  status      String     @default("in-progress")
  priority    String     @default("medium")
  progress    Int        @default(0)
  budget      Float      @default(0)
  spent       Float      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      CrmClient? @relation(fields: [clientId], references: [id])
  creator     User       @relation("UserToCrmProjects", fields: [createdBy], references: [id])
  tenant      Tenant     @relation("TenantToCrmProjects", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@map("crm_projects")
}

model CrmDeal {
  id                String    @id @default(cuid())
  tenantId          String
  title             String
  clientId          String
  value             Float     @default(0)
  stage             String    @default("lead")
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  source            String?
  assignedTo        String?
  lastActivity      DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  client            CrmClient @relation(fields: [clientId], references: [id])
  creator           User      @relation("UserToCrmDeals", fields: [createdBy], references: [id])
  tenant            Tenant    @relation("TenantToCrmDeals", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@map("crm_deals")
}

model Task {
  id               String           @id @default(cuid())
  title            String
  description      String?
  status           String           @default("todo")
  priority         String           @default("medium")
  dueDate          DateTime?
  estimatedHours   Float?
  actualHours      Float            @default(0)
  projectId        String? // Nullable: allows personal tasks without a project
  parentId         String? // For subtasks - parent task ID
  customFields     Json? // JSON object for custom field values
  tags             String[]         @default([])
  isBlocked        Boolean          @default(false)
  blockReason      String?
  tenantId         String
  // Agile/Scrum fields
  sprintId         String?
  epicId           String?
  storyPoints      Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignees        TaskAssignee[]
  dependenciesFrom TaskDependency[] @relation("fromTask")
  dependenciesTo   TaskDependency[] @relation("toTask")
  subtasks         Task[]           @relation("TaskHierarchy")
  parent           Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint           Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic             Epic?            @relation(fields: [epicId], references: [id], onDelete: SetNull)
  timesheets       Timesheet[]
  timeLogs         TimeLog[]

  @@index([projectId])
  @@index([parentId])
  @@index([tenantId, projectId, status])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([sprintId])
  @@index([epicId])
  @@map("tasks")
}

model TaskAssignee {
  id       String @id @default(cuid())
  tenantId String
  taskId   String
  userId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taskId, userId])
  @@index([tenantId, userId])
  @@index([taskId])
  @@map("task_assignees")
}

model TaskDependency {
  id         String @id @default(cuid())
  tenantId   String
  fromTaskId String
  toTaskId   String
  from       Task   @relation("fromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to         Task   @relation("toTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromTaskId, toTaskId])
  @@map("task_dependencies")
}

model KanbanColumn {
  id          String       @id @default(cuid())
  projectId   String
  tenantId    String
  name        String
  color       String       @default("#6b7280")
  position    Int          @default(0)
  wipLimit    Int?
  collapsed   Boolean      @default(false)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cards       KanbanCard[]
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@index([projectId])
  @@index([tenantId])
  @@map("kanban_columns")
}

model KanbanCard {
  id             String       @id @default(cuid())
  projectId      String
  tenantId       String
  columnId       String
  title          String
  description    String?
  status         String       @default("todo")
  priority       String       @default("medium")
  position       Int          @default(0)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  actualHours    Float        @default(0)
  assignees      String[]     @default([])
  labels         String[]     @default([])
  subtasks       Json?
  checklists     Json?
  attachments    Json?
  comments       Json?
  dependencies   String[]     @default([])
  blockedBy      String[]     @default([])
  blocking       String[]     @default([])
  customFields   Json?
  archived       Boolean      @default(false)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  column         KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sprintId           String?
  epicId             String?
  storyPoints        Int?
  sprint             Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic               Epic?        @relation(fields: [epicId], references: [id], onDelete: SetNull)

  isRefined          Boolean      @default(false)
  refinedAt          DateTime?
  refinedBy          String?
  acceptanceCriteria String?

  dodChecks          DoDCheck[]
  cardEmbedding      CardEmbedding?

  @@index([projectId])
  @@index([columnId])
  @@index([tenantId])
  @@index([status])
  @@index([sprintId])
  @@index([epicId])
  @@map("kanban_cards")
}

// ============================================
// AGILE/SCRUM MODELS
// ============================================

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Sprint {
  id               String       @id @default(cuid())
  tenantId         String
  projectId        String
  name             String
  goal             String?
  status           SprintStatus @default(PLANNING)
  startDate        DateTime
  endDate          DateTime
  velocity         Int?
  committedPoints  Int?
  plannedPoints    Int?
  scopeChanges     Int          @default(0)
  avgCycleTimeDays Float?

  wentWell         String?
  needsImprovement String?
  actionItems      String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kanbanCards      KanbanCard[]
  tasks            Task[]
  review           SprintReview?
  capacities       SprintCapacity[]

  @@unique([tenantId, projectId, name])
  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("sprints")
}

model Epic {
  id              String       @id @default(cuid())
  tenantId        String
  projectId       String
  name            String
  description     String?
  status          String       @default("open")
  color           String       @default("#6366f1")
  priority        String       @default("medium")
  startDate       DateTime?
  targetDate      DateTime?
  progress        Int          @default(0)

  businessValue   Int?
  storyPoints     Int?

  riskLevel       String?
  riskReason      String?
  lastRiskCheck   DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kanbanCards     KanbanCard[]
  tasks           Task[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@map("epics")
}

model DefinitionOfDone {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String   @unique
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("definition_of_done")
}

model DoDCheck {
  id        String     @id @default(cuid())
  tenantId  String
  cardId    String
  itemId    String
  checked   Boolean    @default(false)
  checkedBy String?
  checkedAt DateTime?
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([cardId, itemId])
  @@index([tenantId])
  @@index([cardId])
  @@map("dod_checks")
}

model SprintReview {
  id                String   @id @default(cuid())
  tenantId          String
  sprintId          String   @unique
  attendees         Json
  demonstratedItems Json
  stakeholderNotes  String?
  reviewDate        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sprint            Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sprint_reviews")
}

model SprintCapacity {
  id         String   @id @default(cuid())
  tenantId   String
  sprintId   String
  userId     String
  dailyHours Float    @default(8)
  leaveDays  Int      @default(0)
  skills     String[] @default([])
  sprint     Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([tenantId])
  @@index([sprintId])
  @@map("sprint_capacities")
}

model CardEmbedding {
  id        String     @id @default(cuid())
  tenantId  String
  cardId    String     @unique
  embedding Json
  updatedAt DateTime   @updatedAt
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("card_embeddings")
}

model GanttTask {
  id               String            @id @default(cuid())
  projectId        String
  tenantId         String
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime
  progress         Int               @default(0)
  type             String            @default("task")
  priority         String            @default("medium")
  status           String            @default("not-started")
  assignees        String[]          @default([])
  parentId         String?
  critical         Boolean           @default(false)
  duration         Int?
  notes            String?
  groupId          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dependenciesFrom GanttDependency[] @relation("fromGanttTask")
  dependenciesTo   GanttDependency[] @relation("toGanttTask")
  parent           GanttTask?        @relation("GanttTaskHierarchy", fields: [parentId], references: [id])
  children         GanttTask[]       @relation("GanttTaskHierarchy")
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId])
  @@index([parentId])
  @@index([groupId])
  @@map("gantt_tasks")
}

model GanttDependency {
  id         String    @id @default(cuid())
  tenantId   String
  fromTaskId String
  toTaskId   String
  type       String    @default("finish-to-start")
  lag        Int       @default(0)
  from       GanttTask @relation("fromGanttTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to         GanttTask @relation("toGanttTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromTaskId, toTaskId])
  @@index([fromTaskId])
  @@index([toTaskId])
  @@map("gantt_dependencies")
}

model Note {
  id          String       @id @default(cuid())
  title       String
  content     String
  scope       NoteScope    @default(PERSONAL)
  parentId    String?
  projectId   String?
  tenantId    String
  createdById String
  updatedById String?
  tags        String[]     @default([])
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  comments    Comment[]
  parent      Note?        @relation("NoteChildren", fields: [parentId], references: [id])
  children    Note[]       @relation("NoteChildren")
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("NoteCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("NoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([tenantId, scope, createdById])
  @@index([tenantId, projectId])
  @@index([tenantId, parentId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@map("notes")
}

