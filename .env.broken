DATABASE_URL="postgresql://postgres@host.docker.internal:5432/agileflow_db"

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BROKERS=localhost:9092

JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

API_URL=http://localhost:3000
PORT=3000

VITE_API_URL=http://localhost:3000

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

NODE_ENV=development

ENABLE_KAFKA=false
ENABLE_EMAIL=false
ENABLE_KEYCLOAK=false
